{
  "name": "tt-tool",
  "version": "1.1.1",
  "main": "index.js",
  "author": "",
  "private": true,
  "scripts": {
    "clean": "rimraf dist deploy",
    "clean-all": "rimraf dist deploy package-lock.json node_modules",
    "postinstall": "node node_modules/@nodegui/nodegui/scripts/setupMiniQt.js && node node_modules/@nodegui/nodegui/scripts/setupBinary.js && node node_modules/@nodegui/qode/install.js && node node_modules/ffmpeg-static/install.js",
    "init-packer": "npx nodegui-packer --init tt-tool && npm run set-app-icon",
    "pack": "npm run set-app-icon && npm run build && node src/pre-pack.js && npx nodegui-packer --pack ./dist && node src/post-pack.js",
    "build": "webpack --progress --mode production",
    "start": "webpack --progress && qode ./dist/index.js",
    "start-no-build": "qode ./dist/index.js",
    "debug": "webpack --progress && qode --inspect ./dist/index.js",
    "debug-no-build": "qode --inspect ./dist/index.js",
    "set-app-icon": "node src/set-app-icon.js"
  },
  "dependencies": {
    "@nodegui/nodegui": "^0.74.2",
    "adm-zip": "^0.6.1",
    "cli-progress": "^3.12.0",
    "deepl-node": "^1.28.1",
    "ffmpeg-static": "^5.3.0",
    "iso-639-1": "^3.1.6",
    "original-fs": "^1.2.0",
    "subtitle": "^4.2.2",
    "wget-improved": "^3.4.0"
  },
  "devDependencies": {
    "@nodegui/packer": "^1.5.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^24.10.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "file-loader": "^6.2.0",
    "native-addon-loader": "^2.0.1",
    "node-loader": "^2.1.0",
    "rcedit": "^5.0.2",
    "rimraf": "^6.1.3",
    "simple-plist": "^1.3.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-node-externals": "^3.0.0",
    "webpack-permissions-plugin": "^1.0.10"
  }
}
